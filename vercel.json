{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://racing-ai-platform-api-production.up.railway.app/api/v1/:path*"
    }
  ]
}
