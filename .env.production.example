# Frontend variables are injected at Vercel build time.
NEXT_PUBLIC_API_URL=https://racing-ai-platform-api-production.up.railway.app
NEXT_PUBLIC_XRK_UPLOAD_URL=https://racing-ai-platform-api-production.up.railway.app/api/v1/xrk/inspect
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_DEPLOYMENT_MODE=public-demo
# Server-side runtime values used by Vercel and Sites. XRK_UPLOAD_URL bypasses
# the Vercel rewrite so multipart uploads keep their body intact.
API_URL=https://racing-ai-platform-api-production.up.railway.app
XRK_UPLOAD_URL=https://racing-ai-platform-api-production.up.railway.app/api/v1/xrk/inspect

# FastAPI container variables.
APP_ENV=production
APP_MODE=cloud
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DOCS_ENABLED=false
CORS_ORIGINS=https://ai-racing-telemetry-platform.vercel.app,https://ai-racing-telemetry-platform.marcosebastian1144.chatgpt.site
ALLOWED_HOSTS=racing-ai-platform-api-production.up.railway.app,healthcheck.railway.app,localhost,127.0.0.1
MAX_XRK_UPLOAD_BYTES=52428800
XRK_PARSE_TIMEOUT_SECONDS=60
XRK_MAX_CONCURRENT_IMPORTS=2
XRK_RATE_LIMIT_PER_HOUR=10
XRK_MAX_RESPONSE_ROWS=30000
XRK_INSPECTION_TTL_SECONDS=1800
XRK_INSPECTION_CACHE_DIR=/tmp/racing-xrk-inspections
XRK_DEFAULT_DISTANCE_STEP_M=1.0
XRK_MAX_COMPARISON_POINTS=5000
XRK_SERVER_IMPORT_ENABLED=true
XRK_PARSER=auto
WEB_CONCURRENCY=1

# Sites Worker runtime variables. Unlike NEXT_PUBLIC_ values, these can be
# changed without embedding a localhost fallback in browser assets.
API_PREFIX=/api/v1
DEPLOYMENT_MODE=public-demo

# Attach a Railway Volume at /data before starting a Coach Pilot. The SQLite
# adapter remains single-instance and must be replaced before multi-user scale.
DATABASE_PATH=/data/racing.sqlite
STORAGE_BACKEND=local
TASK_QUEUE_BACKEND=inline

# Target production values after the upload/worker phase:
# DATABASE_URL=postgresql+psycopg://user:password@host/database
# STORAGE_BACKEND=s3
# OBJECT_STORAGE_BUCKET=racing-telemetry-production
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_REGION=auto
# TASK_QUEUE_BACKEND=redis
# REDIS_URL=rediss://user:password@host:6379/0
